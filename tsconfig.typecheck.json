{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowJs": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitOverride": false,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "~": ["."],
      "~/*": ["./*"],
      "@": ["."],
      "@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "#app": ["./node_modules/nuxt/dist/app"],
      "#app/*": ["./node_modules/nuxt/dist/app/*"],
      "#imports": ["./.nuxt/imports"],
      "#build": ["./.nuxt"],
      "#build/*": ["./.nuxt/*"]
    }
  },
  "include": [
    "app.vue",
    "components/countries/**/*.vue",
    "components/entities/**/*.vue",
    "components/ui/**/*.vue",
    "layouts/**/*.vue",
    "pages/campaigns/**/*.vue",
    "pages/countries/**/*.vue",
    "pages/entities/**/*.vue",
    "plugins/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "i18n.config.ts",
    ".nuxt/imports.d.ts",
    ".nuxt/types/imports.d.ts",
    ".nuxt/types/i18n-plugin.d.ts",
    ".nuxt/types/nitro-config.d.ts",
    ".nuxt/types/nitro-imports.d.ts",
    ".nuxt/types/schema.d.ts",
    ".nuxt/types/vue-shim.d.ts",
    "types/typecheck-globals.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    ".nuxt/dist",
    "dist",
    "github_pages",
    "workers",
    "scripts",
    "data",
    "content",
    "public"
  ]
}
